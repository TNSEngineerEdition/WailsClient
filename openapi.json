                "title": "GTFSConfiguration"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ResponseCityData": {
                "properties": {
                    "graph": {
                        "items": {
                            "oneOf": [
                                {
                                    "$ref": "#/components/schemas/ResponseGraphNode"
                                },
                                {
                                    "$ref": "#/components/schemas/ResponseGraphStop"
                                }
                            ],
                            "discriminator": {
                                "propertyName": "node_type",
                                "mapping": {
                                    "node": "#/components/schemas/ResponseGraphNode",
                                    "stop": "#/components/schemas/ResponseGraphStop"
                                }
                            }
                        },
                        "type": "array",
                        "title": "Graph"
                    },
                    "tram_routes": {
                        "items": {
                            "$ref": "#/components/schemas/ResponseRoute"
                        },
                        "type": "array",
                        "title": "Tram Routes"
                    },
                    "bus_routes": {
                        "items": {
                            "$ref": "#/components/schemas/ResponseRoute"
                        },
                        "type": "array",
                        "title": "Bus Routes",
                        "x-go-type-skip-optional-pointer": true
                    },
                    "paths": {
                        "additionalProperties": {
                            "additionalProperties": {
                                "items": {
                                    "type": "integer"
                                },
                                "type": "array"
                            },
                            "type": "object"
                        },
                        "type": "object",
                        "title": "Paths",
                        "x-go-type": "map[uint64]map[uint64][]uint64",
                        "x-go-type-skip-optional-pointer": true
                    }
                },
                "type": "object",
                "required": ["graph", "tram_routes"],
                "title": "ResponseCityData"
            },
