                    "gtfs_stop_ids": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Gtfs Stop Ids",
                        "x-go-name": "GTFSStopIDs"
                    }
                },
                "type": "object",
                "required": ["id", "lat", "lon", "neighbors", "name"],
                "title": "ResponseGraphStop"
            },
            "ResponseRoute": {
