                        },
                        "type": "array",
                        "title": "Gtfs Configurations"
                    },
                    "ignored_osm_relations": {
                        "items": {
                            "type": "integer"
                        },
                        "type": "array",
                        "title": "Ignored Osm Relations"
                    },
                    "max_distance_ratio": {
                        "type": "number",
                        "title": "Max Distance Ratio"
                    },
                    "custom_stop_pair_max_distance_checks": {
                        "items": {
                            "$ref": "#/components/schemas/StopPairCheck"
                        },
                        "type": "array",
                        "title": "Custom Stop Pair Max Distance Checks"
                    }
                },
                "type": "object",
                "required": [
                    "city",
                    "country",
                    "image",
                    "osm_relations_area_name",
                    "osm_stops_area_name",
                    "osm_network",
                    "gtfs_configurations",
                    "ignored_osm_relations",
                    "max_distance_ratio",
                    "custom_stop_pair_max_distance_checks"
                ],
                "title": "CityConfiguration"
            },
            "CustomStopPairMapping": {
                "properties": {
                    "source_gtfs_stop_id": {
                        "type": "string",
                        "title": "Source Gtfs Stop Id"
                    },
                    "source_osm_node_id": {
                        "type": "integer",
                        "title": "Source Osm Node Id"
                    },
                    "destination_gtfs_stop_id": {
                        "type": "string",
                        "title": "Destination Gtfs Stop Id"
                    },
