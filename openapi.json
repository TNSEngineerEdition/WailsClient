                        },
                        "type": "array",
                        "title": "Custom Stop Pair Mapping"
                    },
                    "ignored_node_conflicts": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Ignored Node Conflicts"
                    },
                    "stop_group_name_regex": {
                        "type": "string",
                        "title": "Stop Group Name Regex"
                    }
